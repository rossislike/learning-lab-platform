{
  "name": "learning-lab-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "lint": "eslint .",
    "dev:all": "node scripts/dev-supervisor.mjs",
    "scenarios:import": "node scripts/import-scenarios.mjs",
    "scenarios:check": "node scripts/import-scenarios.mjs --check",
    "scenarios:smoke": "node scripts/smoke-test-scenarios.mjs",
    "test:runner": "node --test convex/*.test.mjs scripts/*.test.mjs runner/session-agent/*.test.mjs runner/dispatcher/*.test.mjs runner/gateway/*.test.mjs runner/shared/*.test.mjs",
    "infra:fmt": "terraform fmt -check -recursive infra/aws",
    "infra:validate": "terraform -chdir=infra/aws/account-security validate && terraform -chdir=infra/aws/bootstrap/terraform-backend validate",
    "agent:integration": "node scripts/agent-integration-test.mjs",
    "agent:dev": "node runner/session-agent/agent.mjs",
    "image:build": "images/session-workspace/build.sh",
    "cluster:up": "node scripts/cluster.mjs up",
    "cluster:deploy": "node scripts/cluster.mjs deploy",
    "cluster:status": "node scripts/cluster.mjs status",
    "cluster:logs": "node scripts/cluster.mjs logs",
    "cluster:down": "node scripts/cluster.mjs down",
    "gateway:smoke": "node scripts/gateway-smoke.mjs",
    "dispatcher:once": "KUBERNETES_MODE=kubeconfig node runner/dispatcher/main.mjs --once",
    "image:build:platform": "docker build -f images/platform/Dockerfile -t learning-lab/platform:dev ."
  },
  "dependencies": {
    "@clerk/react": "^6.12.2",
    "@vitejs/plugin-react": "^5.1.1",
    "convex": "^1.33.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.11.1",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3"
  }
}
