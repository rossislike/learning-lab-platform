{
  "name": "learning-lab-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "lint": "eslint .",
    "dev:all": "node scripts/dev-supervisor.mjs",
    "import:react-lab": "node scripts/import-react-product-dashboard.mjs",
    "scenarios:import": "node scripts/import-scenarios.mjs",
    "scenarios:check": "node scripts/import-scenarios.mjs --check",
    "scenarios:smoke": "node scripts/smoke-test-scenarios.mjs",
    "runner:local": "node runner/local-runner.mjs",
    "runner:local:once": "node runner/local-runner.mjs --once",
    "runner:aws": "node runner/aws-runner.mjs",
    "runner:aws:once": "node runner/aws-runner.mjs --once",
    "test:runner": "npm run infra:lambda:build && node --test convex/*.test.mjs scripts/*.test.mjs runner/*.test.mjs infra/aws/terraform/lambda/*.test.mjs",
    "infra:lambda:build": "node infra/aws/terraform/lambda/build.mjs",
    "infra:fmt": "terraform -chdir=infra/aws/terraform fmt -check -recursive",
    "infra:validate": "npm run infra:lambda:build && terraform -chdir=infra/aws/terraform validate"
  },
  "dependencies": {
    "@clerk/react": "^6.12.2",
    "@vitejs/plugin-react": "^5.1.1",
    "convex": "^1.33.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.11.1",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@aws-sdk/client-ecs": "^3.1084.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3"
  }
}
