{
  "name": "learning-lab-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "lint": "eslint .",
    "dev:all": "node scripts/dev-supervisor.mjs",
    "import:react-lab": "node scripts/import-react-product-dashboard.mjs",
    "scenarios:import": "node scripts/import-scenarios.mjs",
    "scenarios:check": "node scripts/import-scenarios.mjs --check",
    "scenarios:smoke": "node scripts/smoke-test-scenarios.mjs",
    "runner:local": "node runner/local-runner.mjs",
    "runner:local:once": "node runner/local-runner.mjs --once",
    "runner:aws": "node runner/aws-runner.mjs",
    "runner:aws:once": "node runner/aws-runner.mjs --once",
    "hosted:image:smoke": "node runner/hosted-learner-image-smoke.mjs",
    "env:isolation:check": "node scripts/validate-environment-isolation.mjs",
    "env:isolation:require-ready": "node scripts/validate-environment-isolation.mjs --require-ready",
    "infra:staging:plan": "node scripts/run-hosted-command.mjs terraform plan staging",
    "infra:staging:apply": "node scripts/run-hosted-command.mjs terraform apply staging",
    "infra:production:plan": "node scripts/run-hosted-command.mjs terraform plan production",
    "infra:production:apply": "node scripts/run-hosted-command.mjs terraform apply production",
    "infra:teardown": "node scripts/teardown-hosted-environment.mjs",
    "convex:staging:deploy": "node scripts/run-hosted-command.mjs convex deploy staging",
    "convex:production:deploy": "node scripts/run-hosted-command.mjs convex deploy production",
    "test:runner": "npm run infra:lambda:build && node --test convex/*.test.mjs scripts/*.test.mjs runner/*.test.mjs infra/aws/modules/hosted-runner/lambda/*.test.mjs",
    "infra:lambda:build": "node infra/aws/modules/hosted-runner/lambda/build.mjs",
    "infra:fmt": "terraform fmt -check -recursive infra/aws",
    "infra:validate": "npm run infra:lambda:build && terraform -chdir=infra/aws/terraform validate && terraform -chdir=infra/aws/account-security validate && terraform -chdir=infra/aws/environments/staging validate && terraform -chdir=infra/aws/environments/production validate"
  },
  "dependencies": {
    "@clerk/react": "^6.12.2",
    "@vitejs/plugin-react": "^5.1.1",
    "convex": "^1.33.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.11.1",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@aws-sdk/client-ecs": "^3.1084.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3"
  }
}
