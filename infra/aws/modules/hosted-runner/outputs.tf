output "artifact_bucket" { value = local.artifact_bucket.id }
output "checkpoint_bucket" { value = local.checkpoint_bucket.id }
output "data_kms_key_arn" { value = local.data_kms_key.arn }
output "ecs_cluster_arn" { value = aws_ecs_cluster.runner.arn }
output "ecs_task_definition_arn" { value = aws_ecs_task_definition.runner.arn }
output "private_subnet_ids" { value = values(aws_subnet.private)[*].id }
output "public_subnet_ids" { value = values(aws_subnet.public)[*].id }
output "runner_ecr_repository_url" { value = local.runner_repository.repository_url }
output "runner_log_group" { value = aws_cloudwatch_log_group.runner.name }
output "session_security_group_id" { value = aws_security_group.session_task.id }
output "alb_security_group_id" { value = aws_security_group.alb.id }
output "dispatcher_security_group_id" { value = aws_security_group.dispatcher.id }
output "dispatcher_execution_role_arn" { value = var.enable_service_secret_boundary ? aws_iam_role.dispatcher_execution[0].arn : null }
output "dispatcher_task_role_arn" { value = var.enable_service_secret_boundary ? aws_iam_role.dispatcher_task[0].arn : null }
output "dispatcher_runner_shared_secret_arn" { value = var.enable_service_secret_boundary ? local.dispatcher_runner_shared_secret.arn : null }
output "service_secrets_kms_key_arn" { value = var.enable_service_secret_boundary ? local.service_secrets_kms_key.arn : null }
output "egress_proxy_security_group_id" { value = aws_security_group.egress_proxy.id }
output "egress_proxy_service_name" { value = var.enable_egress_proxy ? aws_ecs_service.egress_proxy[0].name : null }
output "egress_proxy_repository_url" { value = var.enable_egress_proxy ? local.proxy_repository.repository_url : null }
output "egress_proxy_url" { value = var.enable_egress_proxy ? "http://${aws_lb.egress_proxy[0].dns_name}:${var.egress_proxy_port}" : null }
output "gateway_security_group_id" { value = aws_security_group.gateway.id }
output "vpc_endpoint_ids" { value = merge({ s3 = aws_vpc_endpoint.s3.id }, { for name, endpoint in aws_vpc_endpoint.interface : name => endpoint.id }) }
output "ttl_cleanup_function_name" { value = aws_lambda_function.ttl_cleanup.function_name }
output "module_contract_version" { value = var.module_contract_version }
output "public_alb_dns_name" { value = var.enable_public_alb ? aws_lb.public[0].dns_name : null }
output "public_certificate_arn" { value = var.enable_public_alb ? aws_acm_certificate_validation.public[0].certificate_arn : null }
output "public_url" { value = var.enable_public_alb ? "https://${var.public_hostname}" : null }
