# Browser (Vite)
VITE_CONVEX_URL=
VITE_PRODUCT_SURFACE=local
VITE_AUTH_MODE=disabled
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SESSION_ACCESS_MODE=local-only
VITE_COST_CONTROLS_MODE=local-limits

# Shared by the Convex deployment, the dispatcher, and the gateway. `npm run
# cluster:up` reads it (and VITE_CONVEX_URL) from .env.local for the Helm chart.
RUNNER_SHARED_SECRET=replace-with-a-long-random-secret

# Configure these on the Convex deployment (npx convex env set ...), not here:
#   CLERK_JWT_ISSUER_DOMAIN=            (configured auth only)
#   ALLOW_UNAUTHENTICATED_LOCAL_MODE=true
#   RUNNER_SHARED_SECRET=<same value as above>
#   HOSTED_ENVIRONMENT=local            (dev: dev, requires approved S3 bundles)
#   MAX_ACTIVE_SESSIONS=5

# Running the dispatcher outside the cluster for debugging (npm run dispatcher:once):
# CONVEX_URL=
# GATEWAY_HOST_SUFFIX=lab.localhost
# GATEWAY_PUBLIC_PORT=8080
# SESSIONS_NAMESPACE=sessions
# BUNDLE_HOST_ROOT=/scenarios
