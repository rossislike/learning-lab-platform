# Browser (Vite)
VITE_CONVEX_URL=
VITE_PRODUCT_SURFACE=local
VITE_AUTH_MODE=disabled
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SESSION_ACCESS_MODE=local-only
VITE_COST_CONTROLS_MODE=local-limits

# Runner (local Docker runner until the Kubernetes dispatcher replaces it in Phase 3)
LAB_RUNNER_MODE=local
LOCAL_EDITOR_PROVIDER=openvscode-docker
OPENVSCODE_SERVER_BIN=

# Kubernetes dispatcher / gateway (Phase 3+)
# KUBECONFIG=~/.kube/config
SESSIONS_NAMESPACE=sessions
GATEWAY_PUBLIC_URL=http://localhost:8080
HOSTED_ENVIRONMENT=dev

# dev only
AWS_REGION=us-east-2

# Configure these on the Convex deployment, not in browser code.
CLERK_JWT_ISSUER_DOMAIN=
ALLOW_UNAUTHENTICATED_LOCAL_MODE=true
RUNNER_SHARED_SECRET=replace-with-a-long-random-secret
